{
  "manifest_url_template": "https://raw.githubusercontent.com/{github_repo}/{github_ref}/signed_apps/{app_name}/{cert_name}/signed.ipa",
  "github_repo": "ios-direct-installs/sideloading-direct-installs",
  "github_ref": "main",
  "icon_url_template": "https://raw.githubusercontent.com/{github_repo}/{github_ref}/icons/{app_name}.png",
  "additional_apps": {},
  "exclude_apps": [],
  "cert_filters": {
    "include_revoked": true,
    "include_missing_p12": false
  }
}